# No environment values are required for local development, tests or the web preview.
# The values below are only for developers who create their own cloud project or store build.

# Optional Expo account for EAS builds.
EXPO_OWNER=your-expo-account

# Use application identifiers you own. Do not reuse the production identifiers.
EXPO_PUBLIC_BUNDLE_ID=org.example.privatezakatcalculator

# Optional EAS project identifier created in your own Expo account.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional token for non-interactive EAS commands. Never commit a real value.
EXPO_TOKEN=replace-with-your-own-token
